# ── JWT / Token Configuration ──────────────────────────────────────────
# Replace with a secure random secret key (e.g., openssl rand -hex 32)
SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256

# Token expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=15

# Replace with a secure random secret key for password reset tokens
PASSWORD_RESET_SECRET_KEY=your_secure_password_reset_secret_key_here

# ── MySQL Configuration ────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=qagovhub

# ── Environment ────────────────────────────────────────────────────────
# 'development' | 'staging' | 'production'
ENVIRONMENT=development

# ── Security Settings ──────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
